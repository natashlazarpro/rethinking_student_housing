:3,"children":[{"type":"text","value":"Rethinking Student Housing in Berlin: Data‑Driven Approach","key":"rTI6gZ6iLZ"}],"identifier":"rethinking-student-housing-in-berlin-data-driven-approach","label":"Rethinking Student Housing in Berlin: Data‑Driven Approach","html_id":"rethinking-student-housing-in-berlin-data-driven-approach","implicit":true,"key":"XaQbwAYwCd"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"strong","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Author:","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"uVW8cqsUCl"}],"key":"BHO12DWSYp"},{"type":"text","value":" ","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"GyQIJL4wzR"},{"type":"break","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"FW2qKnYScq"},{"type":"text","value":"Nataliia Lazareva","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"euFPIXkHO6"},{"type":"break","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"z2mpj7LWoq"},{"type":"strong","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Supervisors:","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"DXqkqo1oQ3"}],"key":"um8wJfGLXs"},{"type":"break","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"yH103NQU9h"},{"type":"text","value":"Prof. Dr. Lech Suwala","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"K8uq1Sg9Y5"},{"type":"break","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"ogE2240YBg"},{"type":"text","value":"Dr. Ing. Andreas Brück","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"hHsLOTiRCn"}],"key":"nGV1LxYiB1"},{"type":"heading","depth":4,"children":[{"type":"text","value":"Abstract","key":"qf4v7dprO5"}],"identifier":"abstract","label":"Abstract","html_id":"abstract","implicit":true,"key":"JlhZxdjgsb"},{"type":"paragraph","children":[{"type":"emphasis","children":[{"type":"text","value":"Berlin is experiencing an acute student housing crisis that particularly affects international students and reveals structural tensions between higher education expansion, urban housing policy, and market-driven development. Despite the growing presence of purpose-built student accommodation (PBSA), most students remain dependent on the general rental market, where affordability, stability, and access to basic housing rights are increasingly limited. This research examines the crisis through a data-driven lens, framing student housing as a spatial, social, and economic issue rather than a temporary market imbalance.","key":"QlMj7ZiOPN"}],"key":"tUY5tjoQeO"}],"key":"i4lLt03Dcb"},{"type":"paragraph","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"The study addresses the question of how data-driven decision-making can help bridge the gap between student housing capacities and student demand while responding to students’ basic financial and social needs. It combines spatial analysis of student accommodation capacity and university demand with quantitative market indicators and qualitative insights from surveys and interviews with international students. Geospatial methods, including spatial autocorrelation and Central Place Theory–based modelling, are used to identify areas of heightened market pressure and structural imbalance.","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"V5fMyUnN3M"}],"key":"kayTn7hils"},{"type":"paragraph","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"The findings demonstrate that student housing pressure in Berlin is spatially structured and driven by the concentration of educational functions rather than local shortages alone. By linking spatial patterns with lived experiences of housing insecurity, the study highlights the potential of data-informed planning to support more equitable and coordinated student housing strategies.","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"cFdvZgvgCo"}],"key":"MPhDumcVwU"},{"type":"comment","value":" <h3 align=\"center\"> Master Thesis </h3>      ","key":"vof2UFdsH7"},{"type":"div","children":[{"type":"text","value":"Master Thesis","key":"wX8maNXMgq"}],"key":"oSr6XnMD9S"},{"type":"div","children":[{"type":"text","value":"2026","key":"taRKNQgU1E"}],"key":"jZm2JVIkhh"}],"key":"oaYvSd49gF"}],"key":"IaOhlMrG6P"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Rethinking Student Housing in Berlin","url":"/","group":"Rethinking Student Housing in Berlin"},"next":{"title":"0.2 Table of Contents","url":"/markdowns/table-of-contens","group":"0. Prelimitary Pages"}}},"domain":"http://localhost:3000"}